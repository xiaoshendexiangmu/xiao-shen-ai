合并两个有序列表
class Solution:
    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:
        dummy = ListNode(0)      # 哨兵节点（假头）
        tail = dummy             # tail 一直指向新链表的尾巴
        
        while list1 and list2:               # 两个都还有节点才比
            if list1.val < list2.val:        # 谁小谁先走
                tail.next = list1            # 接上list1
                list1 = list1.next           # list1 往前走
            else:
                tail.next = list2            # 接上list2
                list2 = list2.next           # list2 往前走
            tail = tail.next                 # tail 也跟着往前走
        
        # 有一边空了，剩下的全接上
        tail.next = list1 if list1 else list2


