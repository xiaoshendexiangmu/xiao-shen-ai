返回你可以从这笔交易中获取的最大利润。如果你不能获取任何利润，返回 0 

def maxProfit(self, prices):
    min_price = float('inf')   # 记录见过的最低价
    max_profit = 0             # 记录最大利润
    
    for price in prices:
        if price < min_price:      # 今天比之前都便宜 → 更新最低价
            min_price = price
        else:
            max_profit = max(max_profit, price - min_price)  # 今天卖能赚多少
    
